{
  "name": "aco-studio-private-edition",
  "version": "1.0.1",
  "private": true,
  "description": "Customer-only locally encrypted ACO Studio",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.slabsngrabsaco.aco-studio-private",
    "productName": "ACO STUDIO",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "vault.cjs",
      "formats.cjs",
      "jigs.cjs",
      "index.html",
      "renderer.js",
      "styles.css",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
